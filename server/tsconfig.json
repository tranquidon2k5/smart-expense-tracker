{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "declaration": false,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "..",
    "baseUrl": "./",
    "paths": {
      "@shared/*": [
        "../shared/*"
      ]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "scripts/**/*",
    "../shared/**/*",
    "generated/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../shared/**/*.test.ts",
    "prisma/seed.ts",
    "prisma/seed-data.ts",
    "scripts/**/*",
    "src/**/*.spec.ts"
  ]
}