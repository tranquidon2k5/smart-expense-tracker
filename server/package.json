{
  "name": "so-tien-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST cho Sổ Tiền (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/server/src/main",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "jobs:run": "nest build && node dist/server/scripts/run-jobs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "1.4.7",
    "dotenv": "^16.6.1",
    "nodemailer": "^10.1.0",
    "openai": "7.32.0",
    "pg": "^8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.13.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}