# Sao chép thành server/.env khi chạy API trên máy (không qua Docker)
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://sotien:sotien@localhost:5433/sotien
# Database test e2e: docker compose --profile test up -d db-test
TEST_DATABASE_URL=postgresql://sotien:sotien@localhost:5434/sotien_test

# JWT: đổi thành chuỗi ngẫu nhiên ≥ 32 ký tự khi triển khai
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Origin của web (cookie + CORS khi không đi qua rewrite của Next)
WEB_ORIGIN=http://localhost:3000

# Email (dev: Mailpit http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Sổ Tiền <no-reply@sotien.vn>"

# OpenAI — bỏ trống thì dùng bộ phân tích luật (RuleOnlyProvider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=3000

# Giới hạn đăng nhập: số lần / cửa sổ (phút) theo IP + email
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MIN=15

# Ghi đè "bây giờ" cho demo/test (ISO 8601), bỏ trống = giờ thật
CLOCK_NOW=
# Ngày neo cho seed (mặc định hôm nay)
SEED_TODAY=
